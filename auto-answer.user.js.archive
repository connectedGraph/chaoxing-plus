// ==UserScript==
// @name         学习通自动做题 + 刷课 V4
// @namespace    local.codex.xuexitong.autoanswer
// @version      4.0.0
// @description  在 V3 刷课基础上增加自动做题：截图发送 AI 获取答案，自动填写并提交
// @author       Codex
// @match        *://mooc1.chaoxing.com/mycourse/studentstudy*
// @match        *://*.chaoxing.com/mycourse/studentstudy*
// @match        *://*.chaoxing.com/mooc2-ans/mycourse/studentstudy*
// @match        *://*.chaoxing.com/knowledge/cards*
// @match        *://*.chaoxing.com/mooc2/work/dowork*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // ═══════════════════════════════════════════════════════════════
    // 配置存储
    // ═══════════════════════════════════════════════════════════════
    const STORAGE_KEY = 'chaoxing_autoanswer_config';
    const DEFAULT_CONFIG = {
        provider: 'openai',       // 'openai' | 'anthropic'
        baseUrl: 'https://api.openai.com/v1',
        apiKey: '',
        model: 'gpt-4o',
        thinkingBudget: 0,        // 0 = disabled, >0 = max thinking tokens
        autoSubmit: true,
        submitDelay: 3000,        // ms before clicking submit
        nextDelay: 5000,          // ms after submit before moving on
        enabled: true,
    };

    function loadConfig() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? Object.assign({}, DEFAULT_CONFIG, JSON.parse(raw)) : { ...DEFAULT_CONFIG };
        } catch { return { ...DEFAULT_CONFIG }; }
    }
    function saveConfig(cfg) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg)); } catch {}
    }

    let config = loadConfig();

    // ═══════════════════════════════════════════════════════════════
    // 工具函数
    // ═══════════════════════════════════════════════════════════════
    const sleep = ms => new Promise(r => setTimeout(r, ms));
    const log = (msg, color = '#8B5CF6') => console.log(`%c[AutoAnswer] ${msg}`, `color:${color};font-weight:bold`);
    const warn = msg => log(msg, '#F59E0B');
    const err = msg => log(msg, '#EF4444');

    // ═══════════════════════════════════════════════════════════════
    // html2canvas 加载
    // ═══════════════════════════════════════════════════════════════
    function loadScript(url) {
        return new Promise((resolve, reject) => {
            if (document.querySelector(`script[src="${url}"]`)) { resolve(); return; }
            const s = document.createElement('script');
            s.src = url;
            s.onload = resolve;
            s.onerror = () => reject(new Error('Script load failed: ' + url));
            document.head.appendChild(s);
        });
    }

    // ═══════════════════════════════════════════════════════════════
    // DOM 题目结构提取
    // ═══════════════════════════════════════════════════════════════
    function extractQuizStructure(doc) {
        const questions = [];
        const qDivs = doc.querySelectorAll('.singleQuesId');
        qDivs.forEach((qDiv, idx) => {
            const qid = qDiv.getAttribute('data');
            const timu = qDiv.querySelector('.TiMu.newTiMu');
            const qtype = timu ? timu.getAttribute('data') : '0';
            const titleDiv = qDiv.querySelector('.Zy_TItle .fontLabel');
            const titleText = titleDiv ? titleDiv.textContent.trim() : '';
            const typeSpan = qDiv.querySelector('.newZy_TItle');
            const typeLabel = typeSpan ? typeSpan.textContent.trim() : '';

            const options = [];
            const optionLis = qDiv.querySelectorAll('li[qid]');
            optionLis.forEach(li => {
                const span = li.querySelector('.num_option');
                const letter = span ? span.getAttribute('data') : '';
                const afterA = li.querySelector('a.after');
                const optText = afterA ? afterA.textContent.trim() : '';
                const ariaLabel = li.getAttribute('aria-label') || '';
                options.push({ letter, text: optText, ariaLabel });
            });

            questions.push({
                index: idx + 1,
                qid,
                qtype, // '0'=单选, '1'=多选, '3'=判断
                typeLabel,
                titleText,
                options,
            });
        });
        return questions;
    }

    function isTextGarbled(text) {
        if (!text) return true;
        const cjkNormal = /[一-鿿]/g;
        const cxSecret = /[寘-寿苟-苿]/g;
        const normalMatches = (text.match(cjkNormal) || []).length;
        const secretMatches = (text.match(cxSecret) || []).length;
        return secretMatches > normalMatches * 0.3;
    }

    // ═══════════════════════════════════════════════════════════════
    // 截图功能
    // ═══════════════════════════════════════════════════════════════
    async function ensureHtml2Canvas(win) {
        if (win.html2canvas) return win.html2canvas;
        const url = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
        return new Promise((resolve, reject) => {
            const doc = win.document;
            if (doc.querySelector(`script[src="${url}"]`)) {
                const poll = setInterval(() => {
                    if (win.html2canvas) { clearInterval(poll); resolve(win.html2canvas); }
                }, 100);
                setTimeout(() => { clearInterval(poll); reject(new Error('html2canvas load timeout')); }, 10000);
                return;
            }
            const s = doc.createElement('script');
            s.src = url;
            s.onload = () => {
                const poll = setInterval(() => {
                    if (win.html2canvas) { clearInterval(poll); resolve(win.html2canvas); }
                }, 50);
                setTimeout(() => { clearInterval(poll); reject(new Error('html2canvas not available after load')); }, 5000);
            };
            s.onerror = () => reject(new Error('html2canvas script load failed'));
            (doc.head || doc.documentElement).appendChild(s);
        });
    }

    async function captureQuizImage(targetEl) {
        // html2canvas must run in the same window context as the target element
        const ownerDoc = targetEl.ownerDocument;
        const ownerWin = ownerDoc.defaultView || window;
        const h2c = await ensureHtml2Canvas(ownerWin);

        const canvas = await h2c(targetEl, {
            useCORS: true,
            allowTaint: true,
            backgroundColor: '#ffffff',
            scale: 2,
            scrollX: 0,
            scrollY: -targetEl.scrollTop,
            windowWidth: targetEl.scrollWidth,
            windowHeight: targetEl.scrollHeight,
        });
        return new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
    }

    async function blobToBase64(blob) {
        return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result.split(',')[1]);
            reader.readAsDataURL(blob);
        });
    }

    // ═══════════════════════════════════════════════════════════════
    // AI API 调用
    // ═══════════════════════════════════════════════════════════════
    function buildPrompt(questions) {
        const structureInfo = questions.map(q => {
            const opts = q.options.map(o => `  ${o.letter}: ${o.text || o.ariaLabel}`).join('\n');
            return `题${q.index} [${q.typeLabel}] qid=${q.qid} qtype=${q.qtype}\n题目: ${q.titleText}\n选项:\n${opts}`;
        }).join('\n\n');

        return `你是一个答题助手。请根据截图中显示的题目内容作答。

以下是从DOM提取的题目结构（注意：文字可能被字体加密显示为乱码，请以截图中实际显示的文字为准）：

${structureInfo}

请严格按以下JSON格式返回答案：
{
  "answers": [
    {"qid": "题目ID", "answer": "选项字母(如A/B/C/D)或true/false"}
  ]
}

规则：
- 单选题(qtype=0): answer 为单个字母 A/B/C/D
- 多选题(qtype=1): answer 为多个字母拼接如 "ABC"
- 判断题(qtype=3): answer 为 "true" 或 "false"
- 只返回JSON，不要其他文字`;
    }

    async function callOpenAICompatible(base64Image, prompt) {
        const url = config.baseUrl.replace(/\/$/, '') + '/chat/completions';
        const messages = [
            {
                role: 'user',
                content: [
                    { type: 'text', text: prompt },
                    { type: 'image_url', image_url: { url: `data:image/png;base64,${base64Image}`, detail: 'high' } }
                ]
            }
        ];

        const body = {
            model: config.model,
            messages,
            max_tokens: 2048,
            temperature: 0.1,
        };

        if (config.thinkingBudget > 0) {
            body.reasoning_effort = config.thinkingBudget <= 1024 ? 'low' : (config.thinkingBudget <= 4096 ? 'medium' : 'high');
        }

        const resp = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${config.apiKey}`,
            },
            body: JSON.stringify(body),
        });

        if (!resp.ok) {
            const text = await resp.text();
            throw new Error(`API ${resp.status}: ${text.slice(0, 200)}`);
        }

        const data = await resp.json();
        const content = data.choices?.[0]?.message?.content || '';
        return content;
    }

    async function callAnthropicCompatible(base64Image, prompt) {
        const url = config.baseUrl.replace(/\/$/, '') + '/messages';
        const content = [
            { type: 'image', source: { type: 'base64', media_type: 'image/png', data: base64Image } },
            { type: 'text', text: prompt }
        ];

        const body = {
            model: config.model,
            max_tokens: 2048,
            messages: [{ role: 'user', content }],
        };

        if (config.thinkingBudget > 0) {
            body.thinking = { type: 'enabled', budget_tokens: config.thinkingBudget };
        }

        const headers = {
            'Content-Type': 'application/json',
            'x-api-key': config.apiKey,
            'anthropic-version': '2023-06-01',
            'anthropic-dangerous-direct-browser-access': 'true',
        };

        const resp = await fetch(url, {
            method: 'POST',
            headers,
            body: JSON.stringify(body),
        });

        if (!resp.ok) {
            const text = await resp.text();
            throw new Error(`API ${resp.status}: ${text.slice(0, 200)}`);
        }

        const data = await resp.json();
        const textBlock = data.content?.find(b => b.type === 'text');
        return textBlock?.text || '';
    }

    function parseFirstJSON(text) {
        let pos = 0;
        while (pos < text.length) {
            const start = text.indexOf('{', pos);
            if (start === -1) return null;
            let depth = 0;
            let inStr = false;
            let escape = false;
            for (let i = start; i < text.length; i++) {
                const ch = text[i];
                if (escape) { escape = false; continue; }
                if (ch === '\\' && inStr) { escape = true; continue; }
                if (ch === '"') { inStr = !inStr; continue; }
                if (inStr) continue;
                if (ch === '{') depth++;
                else if (ch === '}') {
                    depth--;
                    if (depth === 0) {
                        try { return JSON.parse(text.slice(start, i + 1)); }
                        catch { break; }
                    }
                }
            }
            pos = start + 1;
        }
        return null;
    }

    async function getAIAnswers(base64Image, questions) {
        const prompt = buildPrompt(questions);
        let raw;
        if (config.provider === 'anthropic') {
            raw = await callAnthropicCompatible(base64Image, prompt);
        } else {
            raw = await callOpenAICompatible(base64Image, prompt);
        }

        log(`AI 原始返回: ${raw.slice(0, 300)}`);

        const parsed = parseFirstJSON(raw);
        if (!parsed || !Array.isArray(parsed.answers)) {
            throw new Error('AI 返回中未找到有效 JSON（需包含 answers 数组）');
        }
        return parsed.answers;
    }

    // ═══════════════════════════════════════════════════════════════
    // 填写答案 & 提交
    // ═══════════════════════════════════════════════════════════════
    function fillAnswers(doc, answers) {
        let filled = 0;
        for (const ans of answers) {
            const { qid, answer } = ans;
            if (!qid || !answer) continue;

            const hiddenInput = doc.getElementById('answer' + qid);
            if (!hiddenInput) { warn(`未找到 answer input: ${qid}`); continue; }

            const answerType = doc.getElementById('answertype' + qid);
            const qtype = answerType ? answerType.value : '0';

            if (qtype === '3') {
                // 判断题: data="true" / data="false"
                const targetVal = answer.toLowerCase() === 'true' ? 'true' : 'false';
                const li = doc.querySelector(`li[qid="${qid}"] .num_option[data="${targetVal}"]`);
                if (li) {
                    const liEl = li.closest('li');
                    if (liEl && typeof liEl.onclick === 'function') {
                        liEl.onclick.call(liEl);
                    } else if (liEl) {
                        liEl.click();
                    }
                    filled++;
                    log(`题 ${qid} (判断) → ${targetVal}`);
                } else {
                    warn(`题 ${qid} 未找到选项 ${targetVal}`);
                }
            } else if (qtype === '0') {
                // 单选题
                const letter = answer.toUpperCase().charAt(0);
                const li = doc.querySelector(`li[qid="${qid}"] .num_option[data="${letter}"]`);
                if (li) {
                    const liEl = li.closest('li');
                    if (liEl && typeof liEl.onclick === 'function') {
                        liEl.onclick.call(liEl);
                    } else if (liEl) {
                        liEl.click();
                    }
                    filled++;
                    log(`题 ${qid} (单选) → ${letter}`);
                } else {
                    warn(`题 ${qid} 未找到选项 ${letter}`);
                }
            } else if (qtype === '1') {
                // 多选题: answer 如 "ABC"
                const letters = answer.toUpperCase().split('');
                for (const letter of letters) {
                    const li = doc.querySelector(`li[qid="${qid}"] .num_option[data="${letter}"]`);
                    if (li) {
                        const liEl = li.closest('li');
                        if (liEl && typeof liEl.onclick === 'function') {
                            liEl.onclick.call(liEl);
                        } else if (liEl) {
                            liEl.click();
                        }
                    }
                }
                filled++;
                log(`题 ${qid} (多选) → ${answer}`);
            }
        }
        return filled;
    }

    async function submitQuiz(doc) {
        // 点击提交按钮
        const submitBtn = doc.querySelector('.btnSubmit');
        if (!submitBtn) { err('未找到提交按钮'); return false; }

        log('点击提交按钮...');
        submitBtn.click();
        await sleep(1000);

        // 处理第一个确认弹窗 (confirmSubWin)
        const confirmWin = doc.getElementById('confirmSubWin');
        if (confirmWin && confirmWin.style.display !== 'none') {
            const okBtn = confirmWin.querySelector('.bluebtn');
            if (okBtn) {
                log('点击确认提交...');
                okBtn.click();
                await sleep(1000);
            }
        }

        // 处理第二个弹窗 (popDiv with 确认提交)
        await sleep(500);
        const popOk = doc.getElementById('popok') || doc.querySelector('.popDiv .jb_btn');
        if (popOk) {
            const popDiv = popOk.closest('.popDiv');
            if (popDiv) {
                const rect = popDiv.getBoundingClientRect();
                if (rect.width > 0 && rect.height > 0) {
                    log('点击弹窗确认...');
                    popOk.click();
                }
            }
        }

        return true;
    }

    // ═══════════════════════════════════════════════════════════════
    // 主流程：自动做题
    // ═══════════════════════════════════════════════════════════════
    async function autoAnswerQuiz(doc) {
        if (!config.enabled || !config.apiKey) {
            warn('自动做题未启用或未配置 API Key');
            return false;
        }

        const rightCon = doc.getElementById('RightCon');
        const form = doc.getElementById('form1');
        if (!rightCon || !form) {
            warn('未检测到测验表单');
            return false;
        }

        log('检测到章节测验，开始自动做题...');

        // 1. 提取题目结构
        const questions = extractQuizStructure(doc);
        if (questions.length === 0) {
            err('未提取到任何题目');
            return false;
        }
        log(`提取到 ${questions.length} 道题目`);

        // 2. 截图
        log('正在截图...');
        let base64Image;
        try {
            const blob = await captureQuizImage(rightCon);
            base64Image = await blobToBase64(blob);
        } catch (e) {
            err('截图失败: ' + e.message);
            return false;
        }

        // 3. 调用 AI
        log('正在请求 AI 答案...');
        let answers;
        try {
            answers = await getAIAnswers(base64Image, questions);
        } catch (e) {
            err('AI 请求失败: ' + e.message);
            return false;
        }
        log(`AI 返回 ${answers.length} 个答案`);

        // 4. 填写答案
        const filled = fillAnswers(doc, answers);
        log(`成功填写 ${filled}/${questions.length} 题`);

        if (filled === 0) {
            err('未能填写任何答案，跳过提交');
            return false;
        }

        // 5. 提交
        if (config.autoSubmit) {
            log(`等待 ${config.submitDelay}ms 后提交...`);
            await sleep(config.submitDelay);
            const submitted = await submitQuiz(doc);
            if (submitted) {
                log('测验已提交！');
                return true;
            }
        }

        return true;
    }

    // ═══════════════════════════════════════════════════════════════
    // 检测当前页面是否为测验页，并找到正确的 document
    // ═══════════════════════════════════════════════════════════════
    function findQuizDocument() {
        function searchDoc(doc, depth, path) {
            if (!doc || depth > 4) return null;
            try {
                if (doc.getElementById('RightCon') && doc.getElementById('form1')) {
                    log(`找到测验文档: ${path}`, '#10B981');
                    return doc;
                }
            } catch { return null; }
            try {
                const iframes = doc.querySelectorAll('iframe');
                for (let i = 0; i < iframes.length; i++) {
                    try {
                        const childDoc = iframes[i].contentDocument || (iframes[i].contentWindow && iframes[i].contentWindow.document);
                        const found = searchDoc(childDoc, depth + 1, `${path} > iframe[${i}]`);
                        if (found) return found;
                    } catch {}
                }
            } catch {}
            return null;
        }

        let topWin = window;
        try { while (topWin.parent && topWin.parent !== topWin) topWin = topWin.parent; } catch {}

        const found = searchDoc(topWin.document, 0, 'top');
        if (found) return found;

        if (topWin.document !== document) {
            const found2 = searchDoc(document, 0, 'current');
            if (found2) return found2;
        }

        warn('findQuizDocument: 未找到。尝试列出所有可访问 iframe...');
        try {
            const iframes = topWin.document.querySelectorAll('iframe');
            iframes.forEach((f, i) => {
                try {
                    const d = f.contentDocument;
                    const hasRC = d && d.getElementById('RightCon');
                    const hasForm = d && d.getElementById('form1');
                    log(`  iframe[${i}] src=${(f.src || '').slice(0, 60)} RightCon=${!!hasRC} form1=${!!hasForm}`, '#6B7280');
                } catch (e) {
                    log(`  iframe[${i}] src=${(f.src || '').slice(0, 60)} 不可访问: ${e.message}`, '#EF4444');
                }
            });
        } catch {}
        return null;
    }

    // ═══════════════════════════════════════════════════════════════
    // 检测任务点完成状态
    // ═══════════════════════════════════════════════════════════════
    function findDocWithElement(id) {
        function search(doc, depth) {
            if (!doc || depth > 4) return null;
            try { if (doc.getElementById(id)) return doc; } catch { return null; }
            try {
                const iframes = doc.querySelectorAll('iframe');
                for (const f of iframes) {
                    try {
                        const d = f.contentDocument || (f.contentWindow && f.contentWindow.document);
                        const found = search(d, depth + 1);
                        if (found) return found;
                    } catch {}
                }
            } catch {}
            return null;
        }
        let topWin = window;
        try { while (topWin.parent && topWin.parent !== topWin) topWin = topWin.parent; } catch {}
        return search(topWin.document, 0) || search(document, 0);
    }

    function getTaskTabs() {
        const doc = findDocWithElement('prev_tab');
        if (!doc) return [];
        const prevList = doc.getElementById('prev_tab');
        if (!prevList) return [];
        return Array.from(prevList.querySelectorAll('li'));
    }

    function isVideoTab(li) {
        // 视频 tab 通常是第一个
        return li && li.id === 'dct1';
    }

    function isQuizTab(li) {
        return li && (li.id === 'dct2' || li.classList.contains('c2'));
    }

    function switchToTab(li) {
        if (li && li.onclick) {
            li.click();
            return true;
        }
        return false;
    }

    // ═══════════════════════════════════════════════════════════════
    // 主循环：视频完成后切到测验，做完后切下一课
    // ═══════════════════════════════════════════════════════════════
    async function handleCurrentUnit() {
        const tabs = getTaskTabs();
        if (tabs.length === 0) return 'no-tabs';

        // 检查所有 tab 是否都已完成（有勾）
        const allDone = tabs.every(li =>
            li.querySelector('.prev_green') || li.classList.contains('c1')
        );
        if (allDone) return 'all-done';

        // 找到视频 tab（通常是 dct1）
        const videoTab = tabs.find(li => isVideoTab(li));
        const quizTab = tabs.find(li => isQuizTab(li));

        // 如果视频 tab 存在且未完成，返回让视频播放逻辑处理
        if (videoTab && !videoTab.querySelector('.prev_green') && !videoTab.classList.contains('c1')) {
            // 确保在视频 tab 上
            if (!videoTab.classList.contains('active')) {
                switchToTab(videoTab);
                await sleep(2000);
            }
            return 'video-pending';
        }

        // 视频已完成，切到测验 tab
        if (quizTab) {
            const quizDone = quizTab.querySelector('.prev_green') || quizTab.classList.contains('c1');
            if (quizDone) return 'all-done';

            if (!quizTab.classList.contains('active')) {
                log('视频已完成，切换到测验 tab...');
                switchToTab(quizTab);
                await sleep(3000);
            }

            // 找到测验文档并做题
            const quizDoc = findQuizDocument();
            if (quizDoc) {
                const success = await autoAnswerQuiz(quizDoc);
                if (success) {
                    log(`等待 ${config.nextDelay}ms 后继续...`);
                    await sleep(config.nextDelay);
                    return 'quiz-done';
                }
                return 'quiz-failed';
            } else {
                warn('切换到测验 tab 后未找到测验文档');
                return 'quiz-not-found';
            }
        }

        return 'no-quiz';
    }

    // ═══════════════════════════════════════════════════════════════
    // 配置面板 UI
    // ═══════════════════════════════════════════════════════════════
    const PANEL_ID = '__autoanswer_panel__';

    function createConfigPanel() {
        if (document.getElementById(PANEL_ID)) return;

        const panel = document.createElement('div');
        panel.id = PANEL_ID;
        panel.innerHTML = `
<div style="position:fixed;bottom:20px;left:20px;width:360px;background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.2);z-index:99998;font-family:-apple-system,'Segoe UI',sans-serif;font-size:13px;overflow:hidden;">
    <div id="aa-header" style="padding:12px 16px;background:linear-gradient(135deg,#8B5CF6,#6D28D9);color:#fff;cursor:move;display:flex;justify-content:space-between;align-items:center;">
        <span style="font-weight:700;">🤖 自动做题配置</span>
        <div style="display:flex;gap:4px;">
            <button id="aa-toggle-body" style="background:rgba(255,255,255,0.2);border:none;color:#fff;cursor:pointer;border-radius:4px;padding:2px 8px;">−</button>
            <button id="aa-close" style="background:rgba(255,255,255,0.2);border:none;color:#fff;cursor:pointer;border-radius:4px;padding:2px 8px;">✕</button>
        </div>
    </div>
    <div id="aa-body" style="padding:12px 16px;max-height:400px;overflow-y:auto;">
        <div style="margin-bottom:10px;">
            <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">API 提供商</label>
            <select id="aa-provider" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;">
                <option value="openai">OpenAI 兼容</option>
                <option value="anthropic">Anthropic 兼容</option>
            </select>
        </div>
        <div style="margin-bottom:10px;">
            <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">Base URL</label>
            <input id="aa-baseurl" type="text" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;" placeholder="https://api.openai.com/v1">
        </div>
        <div style="margin-bottom:10px;">
            <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">API Key</label>
            <input id="aa-apikey" type="password" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;" placeholder="sk-...">
        </div>
        <div style="margin-bottom:10px;">
            <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">模型</label>
            <input id="aa-model" type="text" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;" placeholder="gpt-4o / claude-sonnet-4-6">
        </div>
        <div style="margin-bottom:10px;">
            <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">思考强度 (tokens, 0=关闭)</label>
            <input id="aa-thinking" type="number" min="0" max="32768" step="1024" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;" placeholder="0">
        </div>
        <div style="margin-bottom:10px;display:flex;gap:12px;">
            <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
                <input id="aa-autosubmit" type="checkbox"> 自动提交
            </label>
            <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
                <input id="aa-enabled" type="checkbox"> 启用做题
            </label>
        </div>
        <div style="margin-bottom:10px;display:flex;gap:8px;">
            <div style="flex:1;">
                <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">提交延迟(ms)</label>
                <input id="aa-submitdelay" type="number" min="1000" max="30000" step="1000" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
            </div>
            <div style="flex:1;">
                <label style="display:block;margin-bottom:4px;font-weight:600;color:#374151;">下一题延迟(ms)</label>
                <input id="aa-nextdelay" type="number" min="2000" max="30000" step="1000" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <button id="aa-save" style="flex:1;padding:8px;background:#8B5CF6;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600;">💾 保存配置</button>
            <button id="aa-test" style="flex:1;padding:8px;background:#10B981;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600;">🧪 测试做题</button>
        </div>
        <div id="aa-status" style="margin-top:8px;padding:8px;background:#f3f4f6;border-radius:6px;font-size:12px;color:#6b7280;display:none;"></div>
    </div>
</div>`;
        document.body.appendChild(panel);

        // 填充当前配置
        const $ = id => panel.querySelector('#' + id);
        $('aa-provider').value = config.provider;
        $('aa-baseurl').value = config.baseUrl;
        $('aa-apikey').value = config.apiKey;
        $('aa-model').value = config.model;
        $('aa-thinking').value = config.thinkingBudget;
        $('aa-autosubmit').checked = config.autoSubmit;
        $('aa-enabled').checked = config.enabled;
        $('aa-submitdelay').value = config.submitDelay;
        $('aa-nextdelay').value = config.nextDelay;

        // 事件
        $('aa-save').addEventListener('click', () => {
            config.provider = $('aa-provider').value;
            config.baseUrl = $('aa-baseurl').value;
            config.apiKey = $('aa-apikey').value;
            config.model = $('aa-model').value;
            config.thinkingBudget = parseInt($('aa-thinking').value) || 0;
            config.autoSubmit = $('aa-autosubmit').checked;
            config.enabled = $('aa-enabled').checked;
            config.submitDelay = parseInt($('aa-submitdelay').value) || 3000;
            config.nextDelay = parseInt($('aa-nextdelay').value) || 5000;
            saveConfig(config);
            showStatus('✅ 配置已保存');
        });

        $('aa-test').addEventListener('click', async () => {
            showStatus('⏳ 正在测试...');
            config.provider = $('aa-provider').value;
            config.baseUrl = $('aa-baseurl').value;
            config.apiKey = $('aa-apikey').value;
            config.model = $('aa-model').value;
            config.thinkingBudget = parseInt($('aa-thinking').value) || 0;
            saveConfig(config);

            const quizDoc = findQuizDocument();
            if (!quizDoc) {
                showStatus('❌ 未找到测验页面，请先切换到测验 tab');
                return;
            }
            try {
                const result = await autoAnswerQuiz(quizDoc);
                showStatus(result ? '✅ 做题完成！' : '❌ 做题失败，查看控制台');
            } catch (e) {
                showStatus('❌ ' + e.message);
            }
        });

        $('aa-toggle-body').addEventListener('click', () => {
            const body = $('aa-body');
            const btn = $('aa-toggle-body');
            if (body.style.display === 'none') {
                body.style.display = 'block';
                btn.textContent = '−';
            } else {
                body.style.display = 'none';
                btn.textContent = '+';
            }
        });

        $('aa-close').addEventListener('click', () => panel.remove());

        function showStatus(msg) {
            const el = $('aa-status');
            el.style.display = 'block';
            el.textContent = msg;
            setTimeout(() => { el.style.display = 'none'; }, 5000);
        }

        // 拖拽
        const header = $('aa-header');
        let dragging = false, ox, oy;
        header.addEventListener('mousedown', e => {
            if (e.target.tagName === 'BUTTON') return;
            dragging = true;
            const rect = panel.firstElementChild.getBoundingClientRect();
            ox = e.clientX - rect.left;
            oy = e.clientY - rect.top;
        });
        window.addEventListener('mousemove', e => {
            if (!dragging) return;
            const el = panel.firstElementChild;
            el.style.left = (e.clientX - ox) + 'px';
            el.style.top = (e.clientY - oy) + 'px';
            el.style.bottom = 'auto';
        });
        window.addEventListener('mouseup', () => { dragging = false; });
    }

    // ═══════════════════════════════════════════════════════════════
    // 与主脚本集成：暴露全局接口
    // ═══════════════════════════════════════════════════════════════
    window.autoAnswer = {
        config,
        handleCurrentUnit,
        autoAnswerQuiz,
        findQuizDocument,
        extractQuizStructure,
        showPanel: createConfigPanel,
    };

    // ═══════════════════════════════════════════════════════════════
    // 覆盖主脚本的跳过逻辑：视频结束后自动做题
    // ═══════════════════════════════════════════════════════════════
    function hookMainScript() {
        const checkInterval = setInterval(() => {
            if (!window.app) return;
            clearInterval(checkInterval);

            const origAdvanceAfterVideo = window.app._advanceAfterVideo.bind(window.app);
            const origNextUnit = window.app.nextUnit.bind(window.app);

            window.app._advanceAfterVideo = async function () {
                if (!config.enabled || !config.apiKey) {
                    return origAdvanceAfterVideo();
                }

                const result = await handleCurrentUnit();
                log(`handleCurrentUnit 结果: ${result}`);

                switch (result) {
                    case 'video-pending':
                        // 视频还没完成，不应该到这里，回退
                        return origAdvanceAfterVideo();
                    case 'quiz-done':
                    case 'all-done':
                    case 'no-quiz':
                    case 'no-tabs':
                        // 做完了或没有测验，继续下一课
                        origNextUnit();
                        break;
                    case 'quiz-failed':
                    case 'quiz-not-found':
                        // 做题失败，跳过继续
                        warn('做题失败，跳过此测验');
                        origNextUnit();
                        break;
                    default:
                        origNextUnit();
                }
            };

            // 同样 hook play() 中的跳过逻辑
            const origPlay = window.app.play.bind(window.app);
            window.app.play = async function () {
                const el = await window.app._waitForVideoEl();
                if (el == null && config.enabled && config.apiKey) {
                    // 没有视频，可能是测验页
                    const result = await handleCurrentUnit();
                    if (result === 'quiz-done' || result === 'all-done') {
                        origNextUnit();
                        return;
                    } else if (result === 'video-pending') {
                        return origPlay();
                    }
                }
                return origPlay();
            };

            log('已 hook 主脚本，自动做题功能就绪');
        }, 500);
    }

    // ═══════════════════════════════════════════════════════════════
    // 全课程自动循环（独立模式）
    // ═══════════════════════════════════════════════════════════════
    async function runFullAuto() {
        if (!config.enabled || !config.apiKey) {
            alert('请先配置 API Key 并启用自动做题');
            return;
        }

        log('=== 全自动模式启动 ===', '#10B981');
        let maxIterations = 500;

        while (maxIterations-- > 0) {
            const result = await handleCurrentUnit();
            log(`当前单元结果: ${result}`);

            if (result === 'all-done') {
                // 当前课所有 tab 都完成了，切下一课
                if (window.app) {
                    window.app.nextUnit();
                    await sleep(3000);
                } else {
                    const nextBtn = document.getElementById('prevNextFocusNext');
                    if (nextBtn) { nextBtn.click(); await sleep(3000); }
                    else { break; }
                }
            } else if (result === 'video-pending') {
                // 等视频播放完成
                log('等待视频播放完成...');
                await sleep(10000);
            } else if (result === 'quiz-done') {
                await sleep(2000);
            } else if (result === 'no-tabs') {
                // 可能课程已全部完成
                log('=== 所有课程已完成！ ===', '#10B981');
                alert('🎉 所有课程已完成！');
                break;
            } else {
                // 其他情况，尝试下一课
                if (window.app) {
                    window.app.nextUnit();
                    await sleep(3000);
                } else {
                    break;
                }
            }
        }
    }

    window.autoAnswer.runFullAuto = runFullAuto;

    // ═══════════════════════════════════════════════════════════════
    // 初始化
    // ═══════════════════════════════════════════════════════════════
    createConfigPanel();
    hookMainScript();
    log('自动做题脚本已加载 (v4.0.0)');

})();
